<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>

<body>

  <h1><%= title %></h1>

  <p>College: <%= college %></p>

  <form method="POST" action="/register">

    <label>Name:</label>
    <input type="text" name="name">

    <br><br>

    <label>Email:</label>
    <input type="email" name="email">

    <br><br>

    <label>Age:</label>
    <input type="number" name="age">

    <br><br>

    <button type="submit">Register</button>

  </form>

</body>
</html>